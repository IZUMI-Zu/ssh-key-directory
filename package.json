{
	"name": "ssh-key-directory",
	"private": true,
	"version": "0.1.0",
	"description": "A config-as-code SSH public key directory for Cloudflare Workers.",
	"license": "MIT",
	"homepage": "https://github.com/IZUMI-Zu/ssh-key-directory#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/IZUMI-Zu/ssh-key-directory.git"
	},
	"bugs": {
		"url": "https://github.com/IZUMI-Zu/ssh-key-directory/issues"
	},
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.6.0",
		"pnpm": ">=10.0.0"
	},
	"keywords": [
		"ssh",
		"authorized-keys",
		"cloudflare-workers",
		"public-keys"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test": "node --experimental-strip-types scripts/check-key-directory.mjs && node scripts/check-ui-conventions.mjs",
		"check": "pnpm run lint && pnpm run test && pnpm run cf-typegen:check && pnpm run build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:custom": "pnpm run build && wrangler deploy --config wrangler.local.jsonc",
		"deploy:dry-run": "wrangler deploy --dry-run",
		"deploy:custom:dry-run": "pnpm run build && wrangler deploy --dry-run --config wrangler.local.jsonc",
		"cf-typegen": "wrangler types",
		"cf-typegen:check": "wrangler types --check"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.52.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource/dm-mono": "^5.3.0",
		"@iconify-json/ph": "^1.2.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.8.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"unocss": "^66.7.5",
		"vite": "^8.2.0",
		"wrangler": "^4.123.0"
	}
}
